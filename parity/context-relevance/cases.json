{
  "_doc": "Context-relevance fixture for codewiki_context. Replaces benchmark/check-context-quality.sh (which only checked one anchor's presence). Each case asserts (a) roots@k precision: the EXPECTED roots that SHOULD appear among the top-k Entry Points, scored as precision over the surfaced roots, and (b) nodes recall: expected-anywhere symbols that must appear somewhere in the context output (Entry Points OR Related Symbols). Matching is by symbol NAME (synthetic-120 names are domain-unique). Synthetic-120 cases are FROZEN (deterministic corpus) and gate the thresholds; real-crate cases are ADVISORY (the crate index is edited by other work and may drift).",
  "k": 5,
  "corpora": {
    "synthetic-120": {
      "path": "parity/synthetic-120",
      "gating": true,
      "cases": [
        {
          "id": "auth_flow",
          "task": "how does authentication and login work",
          "expected_roots": ["AuthProvider", "JwtAuthProvider", "authenticate"],
          "expected_anywhere": ["AuthProvider", "JwtAuthProvider", "authenticate", "createAuthProvider", "getUser"]
        },
        {
          "id": "graph_traversal",
          "task": "how does graph traversal and dfs work",
          "expected_roots": ["Graph", "dfs", "traverse"],
          "expected_anywhere": ["Graph", "dfs", "traverse", "add_node", "add_edge", "neighbors"]
        },
        {
          "id": "config_loading",
          "task": "how does configuration loading and lookup work",
          "expected_roots": ["IConfigProvider", "EnvironmentConfigProvider", "Get"],
          "expected_anywhere": ["IConfigProvider", "EnvironmentConfigProvider", "DictionaryConfigProvider", "Get", "TryGet"]
        },
        {
          "id": "user_model_repository",
          "task": "how are users modeled and persisted in the repository",
          "expected_roots": ["User", "UserRepository", "Address"],
          "expected_anywhere": ["User", "UserRepository", "Address", "serialize_users", "to_dict", "from_dict"]
        },
        {
          "id": "animal_hierarchy",
          "task": "how is the animal class hierarchy and shelter structured",
