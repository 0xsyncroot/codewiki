          "expected_anywhere": ["Cache", "retry", "sleep", "get", "set"]
        },
        {
          "id": "rest_api_client_ruby",
          "task": "how does the rest api client send get and post requests",
          "expected_roots": ["Client", "API"],
          "expected_anywhere": ["Client", "API", "get", "post", "build_client"]
        },
        {
          "id": "jwt_decode",
          "task": "how is a jwt token verified and decoded",
