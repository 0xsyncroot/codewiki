          "expected_roots": ["Greeter", "FormalGreeter", "makeGreeter"],
          "expected_anywhere": ["Greeter", "FormalGreeter", "makeGreeter", "greet"]
        },
        {
          "id": "networking_client",
          "task": "how does the networking api client fetch data",
          "expected_roots": ["APIClient", "NetworkSession", "URLSession"],
          "expected_anywhere": ["APIClient", "NetworkSession", "URLSession", "APIError", "fetch"]
